# Mexican Spanish (es_MX) translations for Sauron.
# Scoped to the public invite / create-account flow (welcome-jellyfin.html),
# which is force-rendered in es_MX. Strings not listed here fall back to the
# English source text.
msgid ""
msgstr ""
"Project-Id-Version: sauron\n"
"Report-Msgid-Bugs-To: EMAIL@ADDRESS\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: es_MX\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# ─── Invite landing / header ────────────────────────────────────────────────
msgid "You've been invited!"
msgstr "¡Te han invitado!"

msgid "You've been invited to join the %(name)s server!"
msgstr "¡Te han invitado a unirte al servidor %(name)s!"

msgid "To join"
msgstr "Para unirte a"

msgid "Join the ultimate media server experience."
msgstr "Únete a la mejor experiencia en servidores multimedia."

msgid "Accept Invitation"
msgstr "Aceptar invitación"

msgid "Get ready to join the magic"
msgstr "Prepárate para unirte a la magia"

# ─── Create-account form ────────────────────────────────────────────────────
msgid "Create Account"
msgstr "Crear cuenta"

msgid "Set up your magical account"
msgstr "Configura tu cuenta mágica"

msgid "Username"
msgstr "Usuario"

msgid "Enter your username"
msgstr "Ingresa tu usuario"

msgid "Email"
msgstr "Correo electrónico"

msgid "Enter your email"
msgstr "Ingresa tu correo electrónico"

msgid "Password"
msgstr "Contraseña"

msgid "Create a password"
msgstr "Crea una contraseña"

msgid "At least 8 characters, with one uppercase letter, one lowercase letter, and one number."
msgstr "Mínimo 8 caracteres, con al menos una mayúscula, una minúscula y un número."

msgid "Confirm Password"
msgstr "Confirmar contraseña"

msgid "Confirm your password"
msgstr "Confirma tu contraseña"

msgid "Invite Code"
msgstr "Código de invitación"

msgid "Enter invite code"
msgstr "Ingresa el código de invitación"

msgid "Creating account..."
msgstr "Creando cuenta..."

msgid "Secure invitation system powered by Wizarr"
msgstr "Sistema de invitaciones seguro con tecnología de Wizarr"

# ─── Validation / error messages ────────────────────────────────────────────
msgid "This field is required."
msgstr "Este campo es obligatorio."

msgid "Username must be 3 to 15 characters."
msgstr "El usuario debe tener entre 3 y 15 caracteres."

msgid "Username can contain letters, numbers, dashes (-), underscores (_), apostrophes ('), and periods (.)."
msgstr "El usuario puede contener letras, números, guiones (-), guiones bajos (_), apóstrofos (') y puntos (.)."

msgid "Please enter a valid email address."
msgstr "Favor de introducir una dirección de correo válida."

msgid "Invalid e-mail address."
msgstr "Dirección de correo electrónico inválida."

msgid "Password must be at least 8 characters."
msgstr "La contraseña debe tener al menos 8 caracteres."

msgid "Password must contain at least one uppercase letter, one lowercase letter, and one number."
msgstr "La contraseña debe contener al menos una letra mayúscula, una letra minúscula y un número."

msgid "Passwords must match."
msgstr "Las contraseñas deben coincidir."

msgid "Please correct the highlighted fields."
msgstr "Favor de corregir los campos marcados."

msgid "User or e-mail already exists."
msgstr "El usuario o el correo electrónico ya existe."
